LIVEKIT_URL=wss://<your-livekit-host>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# Voice pipeline — LiveKit Inference (uses LIVEKIT_* credentials above; no STT/TTS/LLM provider keys)
# Defaults match https://livekit.com/products/inference + Agents homepage (Gemma 4)
# LIVEKIT_STT_MODEL=deepgram/flux-general
# LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
# LIVEKIT_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Canvas Three.js scene generation — anthropic | openai | google (separate from voice LLM)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
# Optional separate model for Three.js scene generation
# LLM_RENDER_MODEL=claude-sonnet-4-5-20250929

# Provider API key (set the one matching LLM_PROVIDER) — required for canvas rendering
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# OPENAI_API_KEY=<your-openai-api-key>
# GOOGLE_GENERATIVE_AI_API_KEY=<your-google-api-key>

NEXT_PUBLIC_LIVEKIT_URL=wss://<your-livekit-host>

# Domain / subject vertical (agent + UI must match)
# Options: physics | chemistry | mathematics | biology | programming
DOMAIN=physics
NEXT_PUBLIC_DOMAIN=physics

# Feedback sharing gate (required in production — share this code, not your API keys)
FEEDBACK_ACCESS_CODE=<shared-invite-code>
# Optional comma-separated browser origins allowed to mint tokens
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
