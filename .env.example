LIVEKIT_URL=wss://<your-livekit-host>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# Voice pipeline — STT / TTS
# Prefer Deepgram when DEEPGRAM_API_KEY is set (more reliable than LiveKit Inference STT sockets).
# STT_PROVIDER=deepgram
# TTS_PROVIDER=deepgram
# DEEPGRAM_API_KEY=<your-deepgram-api-key>
# DEEPGRAM_STT_MODEL=nova-3-general
# DEEPGRAM_TTS_MODEL=aura-2-asteria-en
#
# Or use LiveKit Inference for STT/TTS (LIVEKIT_* credentials above):
# STT_PROVIDER=livekit
# TTS_PROVIDER=livekit
# LIVEKIT_STT_MODEL=deepgram/flux-general
# LIVEKIT_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Voice LLM + canvas Three.js generation — qwen | anthropic | kimi | openai | google
# (bills the provider directly; does not use LiveKit Inference LLM credits)
# Default: Qwen 3.8 Max via DashScope (OpenAI-compatible)
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.8-max
# Optional separate model for Three.js scene generation
# LLM_RENDER_MODEL=qwen3.8-max
# Optional DashScope / Qwen endpoint override (default: international compatible-mode)
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional Kimi / Moonshot (when LLM_PROVIDER=kimi)
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Provider API key (set the one matching LLM_PROVIDER) — required for canvas rendering
DASHSCOPE_API_KEY=<your-dashscope-api-key>
# QWEN_API_KEY=<alias-for-DASHSCOPE_API_KEY>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# MOONSHOT_API_KEY=<your-moonshot-kimi-api-key>
# KIMI_API_KEY=<alias-for-MOONSHOT_API_KEY>
# OPENAI_API_KEY=<your-openai-api-key>
# GOOGLE_GENERATIVE_AI_API_KEY=<your-google-api-key>

NEXT_PUBLIC_LIVEKIT_URL=wss://<your-livekit-host>

# Domain / subject vertical (agent + UI must match)
# Options: physics | chemistry | mathematics | biology | programming
DOMAIN=physics
NEXT_PUBLIC_DOMAIN=physics

# Optional comma-separated browser origins allowed to mint tokens
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
